# Supabase project credentials.
# Never set SUPABASE_SERVICE_ROLE_KEY here or anywhere under src/ — CI fails
# the build if the literal "SERVICE_ROLE" appears under src/.

# Server-side only (src/lib/supabase/server.ts, proxy.ts).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Browser-side (src/lib/supabase/client.ts). Same project values as above,
# exposed to the browser bundle on purpose — the anon key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
